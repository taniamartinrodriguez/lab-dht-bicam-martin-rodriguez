# Documentacion de codigo - BiCIAM
PROJECT_NAME           = "BiCIAM"
PROJECT_NUMBER         = "1.0.0"
PROJECT_BRIEF          = "Framework de algoritmos metaheuristicos y busqueda"
OUTPUT_DIRECTORY       = docs/doxygen
INPUT                  = src/main/java docs/API_BiCIAM.md
USE_MDFILE_AS_MAINPAGE = docs/API_BiCIAM.md
RECURSIVE              = YES
FILE_PATTERNS          = *.java *.md
OPTIMIZE_OUTPUT_JAVA   = YES
JAVADOC_AUTOBRIEF      = YES
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = NO
GENERATE_XML           = NO
HAVE_DOT               = NO
QUIET                  = NO
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = NO
INPUT_ENCODING         = UTF-8
EXCLUDE_PATTERNS       = */target/*
# EXTRACT_ALL muestra las clases antiguas aunque falten comentarios.
# No sustituye a documentar manualmente clases, metodos y atributos.
